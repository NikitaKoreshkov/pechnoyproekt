generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Account {
  id                String  @id
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model AdvantagesConfig {
  id        String   @id
  title     String   @default("Наши преимущества")
  subtitle  String   @default("Почему клиенты выбирают именно нас")
  items     Json
  createdAt DateTime @default(now())
  updatedAt DateTime
}

model CalculatorConfig {
  id                String   @id
  houseTypes        Json
  finishingOptions  Json
  additionalOptions Json
  stepTexts         Json
  areaSettings      Json?
  formula           String
  whatsappTemplate  String
  estimateTemplate  String
  createdAt         DateTime @default(now())
  updatedAt         DateTime
}

model CalcBarbecueOption {
  id         String   @id @default(cuid())
  variant    String   // "standard" | "vip"
  optionType String   // "main" | "extra"
  name       String
  price      Int
  image      String   @default("")
  sortOrder  Int      @default(0)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([variant, optionType])
  @@index([sortOrder])
}

model CatalogFiltersConfig {
  id           String   @id
  config       Json
  createdAt    DateTime @default(now())
  updatedAt    DateTime
  sectionId    String?
  subsectionId String?

  @@index([sectionId])
  @@index([subsectionId])
}

model CatalogSection {
  id                String              @id
  title             String
  slug              String              @unique
  order             Int                 @default(0)
  createdAt         DateTime            @default(now())
  updatedAt         DateTime
  subsections CatalogSubsection[]

  @@index([order])
}

model CatalogSeoTextConfig {
  id        String   @id
  title     String   @default("Печные комплексы и мангалы от Печнойпроект")
  content   String
  createdAt DateTime @default(now())
  updatedAt DateTime
}

model CatalogSubsection {
  id                   String                 @id
  sectionId            String
  title                String
  slug                 String
  order                Int                    @default(0)
  createdAt            DateTime               @default(now())
  updatedAt            DateTime
  section        CatalogSection         @relation(fields: [sectionId], references: [id], onDelete: Cascade)
  subsubsections CatalogSubsubsection[]
  popularItems   PopularItem[]
  projects       Project[]

  @@unique([sectionId, slug])
  @@index([sectionId])
  @@index([slug])
}

model CatalogSubsubsection {
  id                String            @id
  subsectionId      String
  title             String
  slug              String
  order             Int               @default(0)
  createdAt         DateTime          @default(now())
  updatedAt         DateTime
  subsection   CatalogSubsection @relation(fields: [subsectionId], references: [id], onDelete: Cascade)
  popularItems PopularItem[]
  projects     Project[]

  @@unique([subsectionId, slug])
  @@index([slug])
  @@index([subsectionId])
}

model ContractTemplateConfig {
  id        String   @id
  filePath  String?
  createdAt DateTime @default(now())
  updatedAt DateTime
}

model CookiesConfig {
  id        String   @id
  title     String   @default("Политика использования файлов Cookie")
  content   String
  createdAt DateTime @default(now())
  updatedAt DateTime
}

model EstimateDocument {
  id        String   @id
  userId    String
  title     String
  params    Json
  createdAt DateTime @default(now())
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
}

model FAQItem {
  id        String   @id
  question  String
  answer    String
  order     Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime

  @@index([order])
}

model FooterConfig {
  id                    String   @id
  companyName           String   @default("Печнойпроект")
  companyDescription    String   @default("Печные комплексы, мангалы и барбекю по индивидуальным проектам. Качественно, надежно, с гарантией.")
  whatsappUrl           String   @default("https://max.ru/u/f9LHodD0cOIpDPuCcMZgHcMs8Q34keKCS0fVwDTH9yLudQ6BH_47EGRwPTE")
  whatsappText          String   @default("Печнойпроект\n\nЗдравствуйте! Хочу узнать больше о печных комплексах и мангалах.\n\nГотов(а) ответить на ваши вопросы!")
  phone                 String   @default("+7 (495) 023-82-15")
  email                 String   @default("agtspb@inbox.ru")
  addressLine1          String   @default("Санкт-Петербург")
  addressLine2          String   @default("")
  addressLine3          String   @default("")
  workingHoursLine1     String   @default("Пн-Пт: 9:00 - 18:00")
  workingHoursLine2     String   @default("Сб-Вс: выходные")
  newsletterTitle       String   @default("Новости и акции")
  newsletterDescription String   @default("Подпишитесь на рассылку и получайте информацию о новых проектах и специальных предложениях")
  copyright             String   @default("© 2025 Печнойпроект. Все права защищены.")
  ip                    String   @default("ООО \"АКВАГАЗТЕХ\"")
  inn                   String   @default("ИНН: 4706094590, КПП: 470601001, ОГРН: 1254700021575")
  legalAddress          String   @default("Санкт-Петербург")
  createdAt             DateTime @default(now())
  updatedAt             DateTime
  phone2                String?
  youtubeUrl            String?
  telegramUrl           String?
  vkUrl                 String?
}

model HeaderConfig {
  id           String   @id
  logoText     String   @default("Печнойпроект")
  logoImage    String?
  showLogoText Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime
}

model HeroConfig {
  id        String   @id
  heroImage String   @default("/images/main.png")
  title     String   @default("Трубы ПНД и комплектующие")
  subtitle  String   @default("Качественно. Быстро. Надёжно. С гарантией.")
  createdAt DateTime @default(now())
  updatedAt DateTime
}

model NewsletterSubscriber {
  id        String   @id
  email     String   @unique
  createdAt DateTime @default(now())
}

model Order {
  id              String   @id
  projectId       String
  projectTitle    String
  amount          Int      // в копейках для ЮKassa
  config          Json     // выбранные опции, панели и т.д.
  status          String   @default("pending")  // pending, paid, failed, cancelled
  yookassaPaymentId String?
  email           String?
  phone           String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([status])
  @@index([yookassaPaymentId])
}

model PopularItem {
  id                   String                @id
  panelId              String
  title                String
  area                 Int
  priceFrom            Int
  priceTo              Int?
  floors               Float                 @default(1)
  material             String
  buildTime            Int                   @default(30)
  completion           String                @default("под ключ")
  region               String                @default("Москва")
  image                String
  images               String[]              @default([])
  tags                 String[]              @default([])
  hasTerrasse          Boolean               @default(false)
  hasBath              Boolean               @default(false)
  hasGarage            Boolean               @default(false)
  features             String[]              @default([])
  description          String?
  advantages           String[]              @default([])
  technicalSpecs       String?
  specs                Json?
  filterValues         Json?
  order                Int                   @default(0)
  slug                 String?               @unique
  projectSlug          String?
  subsectionId         String?
  subsubsectionId      String?
  createdAt            DateTime              @default(now())
  updatedAt            DateTime
  panel PopularPanel @relation(fields: [panelId], references: [id], onDelete: Cascade)
  CatalogSubsection    CatalogSubsection?    @relation(fields: [subsectionId], references: [id])
  CatalogSubsubsection CatalogSubsubsection? @relation(fields: [subsubsectionId], references: [id])

  @@index([panelId, order])
  @@index([projectSlug])
  @@index([slug])
  @@index([subsectionId])
  @@index([subsubsectionId])
}

model PopularPanel {
  id        String        @id
  title     String
  order     Int           @default(0)
  createdAt DateTime      @default(now())
  updatedAt DateTime
  items     PopularItem[]
}

model PrivacyConfig {
  id        String   @id
  title     String   @default("Политика конфиденциальности")
  content   String
  createdAt DateTime @default(now())
  updatedAt DateTime
}

model ProcessStepsConfig {
  id        String   @id
  title     String   @default("Печнойпроект — ваш надёжный партнёр")
  subtitle  String   @default("")
  steps     Json
  createdAt DateTime @default(now())
  updatedAt DateTime
}

model Project {
  id                   String                @id
  slug                 String                @unique
  subsectionId         String?
  subsubsectionId      String?
  title                String
  area                 Int
  priceFrom            Int
  priceTo              Int?
  floors               Float
  material             String
  buildTime            Int
  completion           String
  region               String
  image                String
  images               String[]              @default([])
  tags                 String[]              @default([])
  hasTerrasse          Boolean               @default(false)
  hasBath              Boolean               @default(false)
  hasGarage            Boolean               @default(false)
  features             String[]              @default([])
  description          String?
  advantages           String[]              @default([])
  technicalSpecs       String?
  specs                Json?
  filterValues         Json?
  variationGroupId     String?
  createdAt            DateTime              @default(now())
  updatedAt            DateTime
  videoUrl             String?
  subsection          CatalogSubsection?    @relation(fields: [subsectionId], references: [id], onDelete: SetNull)
  subsubsection       CatalogSubsubsection? @relation(fields: [subsubsectionId], references: [id], onDelete: SetNull)
  favoritedBy         User[]                @relation("UserFavorites")
  comparedBy          User[]                @relation("UserCompare")

  @@index([completion])
  @@index([material])
  @@index([region])
  @@index([slug])
  @@index([subsectionId])
  @@index([subsubsectionId])
  @@index([variationGroupId])
}

model Review {
  id        String   @id
  name      String
  city      String
  text      String
  image     String?
  date      DateTime @default(now())
  createdAt DateTime @default(now())
  updatedAt DateTime
}

model ReviewsConfig {
  id          String   @id
  title       String   @default("Реальные фото и отзывы наших клиентов")
  description String   @default("Мы собрали часть отзывов от наших клиентов.\n\nОстальные отзывы можно посмотреть по запросу или в наших соцсетях.")
  createdAt   DateTime @default(now())
  updatedAt   DateTime
}

model Session {
  id           String   @id
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model SiteMetadataConfig {
  id              String   @id
  faviconUrl      String?
  appleTouchIcon  String?
  siteTitle       String   @default("Печные комплексы и мангалы | Печнойпроект")
  siteDescription String   @default("Проектирование и изготовление печных комплексов, мангалов и барбекю. Индивидуальные решения, качественные материалы, гарантия.")
  siteKeywords    String   @default("трубы ПНД, трубы ПЭ, комплектующие для труб, водопровод, канализация, газопровод, фитинги, Москва, Россия, Санкт-Петербург, Ленинградская область")
  ogImage         String   @default("/images/house.jpg")
  createdAt       DateTime @default(now())
  updatedAt       DateTime
}

model TermsConfig {
  id        String   @id
  title     String   @default("Условия использования")
  content   String
  createdAt DateTime @default(now())
  updatedAt DateTime
}

model User {
  id                    String             @id
  email                 String             @unique
  passwordHash          String
  name                  String?
  image                 String?
  emailVerified         DateTime?
  isActive              Boolean            @default(false)
  role                  Role               @default(USER)
  createdAt             DateTime           @default(now())
  updatedAt             DateTime
  accounts      Account[]
  sessions      Session[]
  documents     EstimateDocument[]
  leads         WhatsAppLead[]
  favorites     Project[]          @relation("UserFavorites")
  compareProjects Project[]        @relation("UserCompare")
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model WhatsAppLead {
  id        String   @id
  name      String?
  phone     String?
  message   String?
  params    Json?
  purpose   String?
  source    String?
  projectId String?
  createdAt DateTime @default(now())
  userId    String?
  user User? @relation(fields: [userId], references: [id])

  @@index([createdAt])
}

enum Role {
  USER
  ADMIN
  SUPER_ADMIN
}
